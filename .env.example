# Copy to .env.local and fill in. Never commit real values.

# --- Core ---
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# 32 random bytes, base64. Encrypts provider credentials in the vault.
VAULT_KEY=
# Postgres connection string (pooled). On Vercel the Neon integration sets this.
DATABASE_URL=
# Local dev only: where auto-generated dev secrets are stored.
DATA_DIR=
# Email of the platform owner (you). Unlocks /ops.
ADMIN_EMAIL=
# Clerk login (dashboard.clerk.com > API keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
# Extra HTTPS hostnames providers may list (e.g. a tunnel to your own GPU), comma separated.
PROVIDER_UPSTREAM_HOSTS=
# Platform fee in basis points (1000 = 10%).
PLATFORM_FEE_BPS=1000
# true = fake payments + mock model backends when keys are missing. Never true in production.
DEMO_MODE=true

# --- Payments: buyer → platform (Zelle QR), then admin → provider ---
# Buyers scan a Zelle QR and pay the full amount to the platform.
# After you confirm the deposit, access is issued; you then pay providers their share.
PLATFORM_ZELLE=
PLATFORM_ZELLE_NAME=
# Optional: URL of a Zelle QR image exported from your bank app (preferred over auto-generated).
PLATFORM_ZELLE_QR_URL=
# Also used when paying providers (and optional alternate collection methods).
PLATFORM_VENMO=
PLATFORM_CASHAPP=
PLATFORM_PAYPAL=
# Optional on-chain rail: USDC on Base, verified automatically.
PLATFORM_USDC_ADDRESS=
# base-sepolia (testnet, no real money) or base (mainnet, real money)
USDC_NETWORK=base-sepolia
# Optional custom RPC; defaults to the public Base RPC.
BASE_RPC_URL=

# --- OpenRouter (platform pool "fast" tier; required if you sell pool credit) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# --- Darkbloom (optional private pool tier) ---
DARKBLOOM_BASE_URL=
DARKBLOOM_API_KEY=
DARKBLOOM_MODEL=

# --- Tinfoil (verifiable enclave inference; used when personal data is detected) ---
TINFOIL_API_KEY=
TINFOIL_MODEL=llama3-3-70b

# --- Superlinked SIE (optional: embeddings, rerank, personal-data check) ---
SIE_BASE_URL=
SIE_API_KEY=
SIE_EMBED_MODEL=BAAI/bge-m3
SIE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
SIE_PII_MODEL=urchade/gliner_multi-v2.1
SIE_CHAT_MODEL=Qwen/Qwen3-4B-Instruct-2507

# --- cognee (shared agent memory) ---
COGNEE_BASE_URL=
COGNEE_API_KEY=
COGNEE_TENANT_ID=
